rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Allow read/write access to all users for posts
    match /posts/{document} {
      allow read, write: if true;
    }
    
    // Allow read/write access to all users for users collection
    match /users/{document} {
      allow read, write: if true;
    }
    
    // Allow read/write access to all users for prices
    match /prices/{document} {
      allow read, write: if true;
    }
    
    // Allow read/write access to all users for comments
    match /comments/{document} {
      allow read, write: if true;
    }
    
    // Allow read/write access to all users for notifications
    match /notifications/{document} {
      allow read, write: if true;
    }
    
    // Allow read/write access to all users for follows
    match /follows/{document} {
      allow read, write: if true;
    }
    
    // Allow read/write access to all users for saved posts
    match /savedPosts/{document} {
      allow read, write: if true;
    }
    
    // Allow read/write access to all users for likes
    match /likes/{document} {
      allow read, write: if true;
    }
    
    // Allow read/write access to all users for conversations
    match /conversations/{document} {
      allow read, write: if true;
      
      // Allow read/write access to messages subcollection
      match /messages/{messageId} {
        allow read, write: if true;
      }
    }
  }
}