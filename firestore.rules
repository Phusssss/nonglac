rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    
    function isAdmin() {
      return isAuthenticated() && 
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }
    
    function isValidUser() {
      return isAuthenticated() && 
        exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }
    
    // Users collection - users can read all profiles but only edit their own
    match /users/{userId} {
      allow read: if true; // Public profiles for social features
      allow create: if isOwner(userId) && 
        request.resource.data.keys().hasAll(['displayName', 'email', 'joinDate']) &&
        request.resource.data.role == null; // Prevent self-promotion to admin
      allow update: if isOwner(userId) && 
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'uid']);
      allow delete: if isOwner(userId) || isAdmin();
    }
    
    // Posts collection - authenticated users can create, authors can edit
    match /posts/{postId} {
      allow read: if resource.data.status != 'rejected'; // Hide rejected posts
      allow create: if isAuthenticated() && 
        request.resource.data.authorId == request.auth.uid &&
        request.resource.data.keys().hasAll(['title', 'content', 'category', 'authorId', 'createdAt']);
      allow update: if isOwner(resource.data.authorId) || isAdmin();
      allow delete: if isOwner(resource.data.authorId) || isAdmin();
    }
    
    // Comments collection - authenticated users can comment
    match /comments/{commentId} {
      allow read: if true;
      allow create: if isAuthenticated() && 
        request.resource.data.authorId == request.auth.uid &&
        request.resource.data.keys().hasAll(['postId', 'content', 'authorId', 'createdAt']);
      allow update: if isOwner(resource.data.authorId) || isAdmin();
      allow delete: if isOwner(resource.data.authorId) || isAdmin();
    }
    
    // Prices collection - read-only for users, write for admin/system
    match /prices/{priceId} {
      allow read: if true; // Public price data
      allow write: if isAdmin(); // Only admin can update prices
    }
    
    // Likes collection - users can like/unlike
    match /likes/{likeId} {
      allow read: if true;
      allow create: if isAuthenticated() && 
        request.resource.data.userId == request.auth.uid;
      allow delete: if isOwner(resource.data.userId);
    }
    
    // Follows collection - users can follow/unfollow
    match /follows/{followId} {
      allow read: if true;
      allow create: if isAuthenticated() && 
        request.resource.data.followerId == request.auth.uid;
      allow delete: if isOwner(resource.data.followerId);
    }
    
    // Saved posts collection - users can save/unsave their own posts
    match /savedPosts/{savedPostId} {
      allow read, write: if isAuthenticated() && 
        resource.data.userId == request.auth.uid;
    }
    
    // Notifications collection - users can read their own notifications
    match /notifications/{notificationId} {
      allow read: if isOwner(resource.data.userId);
      allow create: if isAuthenticated(); // System can create notifications
      allow update: if isOwner(resource.data.userId); // Mark as read
      allow delete: if isOwner(resource.data.userId) || isAdmin();
    }
    
    // Conversations collection - only participants can access
    match /conversations/{conversationId} {
      allow read, write: if isAuthenticated() && 
        request.auth.uid in resource.data.participants;
      allow create: if isAuthenticated() && 
        request.auth.uid in request.resource.data.participants;
      
      // Messages subcollection - only conversation participants
      match /messages/{messageId} {
        allow read, write: if isAuthenticated() && 
          request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants;
      }
    }
    
    // User actions collection - for analytics (users can create their own actions)
    match /userActions/{actionId} {
      allow read: if isAdmin(); // Only admin can read analytics
      allow create: if isAuthenticated() && 
        request.resource.data.userId == request.auth.uid;
    }
    
    // Reports collection - users can report, admin can manage
    match /reports/{reportId} {
      allow read: if isAdmin() || isOwner(resource.data.reporterId);
      allow create: if isAuthenticated() && 
        request.resource.data.reporterId == request.auth.uid;
      allow update: if isAdmin(); // Only admin can update report status
    }
    
    // Moderation queue - admin only
    match /moderationQueue/{queueId} {
      allow read, write: if isAdmin();
    }
    
    // Analytics collection - admin only
    match /analytics/{analyticsId} {
      allow read, write: if isAdmin();
    }
    
    // Missions collection - users can read and update their own missions data
    match /userMissions/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if isOwner(userId);
      allow update: if isOwner(userId) && 
        // Chỉ cho phép update các field được phép
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['missions', 'score', 'unlockedBadges', 'selectedProfessionBadge', 
                    'dailyLoginStreak', 'lastLoginDate', 'lastUpdated']);
      allow delete: if isAdmin();
    }
  }
}